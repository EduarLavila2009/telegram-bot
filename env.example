# Copia este archivo como .env en esta misma carpeta y rellena los valores.

# Token que te da @BotFather (ver INSTRUCCIONES.md).
TELEGRAM_BOT_TOKEN=

# Tu ID numérico de Telegram (solo este usuario podrá usar el bot).
# Puedes obtenerlo escribiendo a @userinfobot o @getidsbot.
TELEGRAM_ALLOWED_USER_ID=

# Id del canal fuente (ej. SUFEVICA). Suele ser -100xxxxxxxxxx. Con el bot como admin del canal.
# Sin esto, las fotos publicadas en canales no se procesan.
# TELEGRAM_SOURCE_CHANNEL_ID=-1001234567890

# Opcional: ruta absoluta al Excel. Si se omite, se usa consolidado_financiero.xlsx en esta carpeta.
# EXCEL_PATH=C:\ruta\consolidado_financiero.xlsx
# Excel de facturas recibidas (compra). Si se omite, FACTURAS-RECIBIDAS-V3.xlsx en esta carpeta.
# FACTURAS_RECIBIDAS_XLSX=C:\ruta\FACTURAS-RECIBIDAS-V3.xlsx
# Carpeta para libros mensuales de retenciones emitidas (relativa a esta carpeta).
# RETENCIONES_EMITIDAS_DIR=RETENCIONES-EMITIDAS-NUEVO
# Imagen de firma+sello para el PDF (ideal PNG con fondo transparente).
# Si se omite, usa firma_sello_transparente.png en esta carpeta.
# FIRMA_SELLO_PATH=firma_sello_transparente.png

# Recomendado para notas de voz: API key de OpenAI (modelo whisper-1).
# Sin esto, se intentará Google SpeechRecognition + pydub (requiere ffmpeg instalado).
OPENAI_API_KEY=

# Opcional: Gemini (solo si usas funciones que lo requieran).
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Opcional: Configuración para el envío de reportes por correo electrónico (SMTP)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu_correo@gmail.com
# SMTP_PASSWORD=tu_contrasena_de_aplicacion
# DEFAULT_ACCOUNTANT_EMAIL=correo_contador@ejemplo.com

